<?xml version="1.0" encoding="UTF-16"?>
<!--
  Task Scheduler definition for scripts\keepalive.ps1. Registered with:

    schtasks /Create /TN "Taken Kings keep-alive" /XML scripts\keepalive-task.xml /F

  Kept in the repo so the schedule is documented and can be restored on a new machine. The paths
  below are absolute: change them if the working copy moves.

  Runs daily, but the script itself does nothing unless the committed leaderboard snapshot has gone
  stale (i.e. the GitHub Action has stopped), so a healthy repo sees no commits from it at all.
  StartWhenAvailable catches up after the machine has been off; it never wakes the machine.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Taken Kings: keeps the leaderboard backend and the GitHub Actions schedule from lapsing. Acts only when the scheduled workflow has stopped running.</Description>
    <URI>\Taken Kings keep-alive</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-10-14T13:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\claude_work\taken_kings\scripts\keepalive.ps1"</Arguments>
      <WorkingDirectory>C:\claude_work\taken_kings</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
